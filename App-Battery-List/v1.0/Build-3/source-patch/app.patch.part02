+    private void handleGuidedSettingsReturn(String returnedPackage) {
+        GuidedReviewStore.State state = reviewStore.load();
+        if (!GuidedReviewAutoAdvance.shouldAdvance(state, returnedPackage)) {
+            if (returnedPackage != null) {
+                logger.log("GUIDED_RETURN | " + returnedPackage + " | auto=" + state.autoAdvance + " | no-auto-advance");
+            }
+            syncGuidedReviewUi();
+            return;
+        }
+
