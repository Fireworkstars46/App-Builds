--- /dev/null
+++ b/new/app/src/main/java/com/fireworkstars46/appbatterylist/GuidedReviewAutoAdvance.java
@@ -0,0 +1,13 @@
+package com.fireworkstars46.appbatterylist;
+
+final class GuidedReviewAutoAdvance {
+    private GuidedReviewAutoAdvance() {}
+
+    static boolean shouldAdvance(GuidedReviewStore.State state, String returnedPackage) {
+        return state != null
+                && state.active
+                && state.autoAdvance
+                && returnedPackage != null
+                && returnedPackage.equals(state.currentPackage());
+    }
+}
diff --git a/old/app/src/main/java/com/fireworkstars46/appbatterylist/GuidedReviewStore.java b/new/app/src/main/java/com/fireworkstars46/appbatterylist/GuidedReviewStore.java
index 1734365..e5981b4 100644
--- a/old/app/src/main/java/com/fireworkstars46/appbatterylist/GuidedReviewStore.java
+++ b/new/app/src/main/java/com/fireworkstars46/appbatterylist/GuidedReviewStore.java
@@ -15,18 +15,21 @@ final class GuidedReviewStore {
     private static final String KEY_INDEX = "index";
     private static final String KEY_PACKAGES = "packages";
     private static final String KEY_SKIPPED = "skipped";
+    private static final String KEY_AUTO_ADVANCE = "auto_advance";
 
     static final class State {
         final boolean active;
         final int index;
         final List<String> packages;
         final Set<String> skipped;
+        final boolean autoAdvance;
 
-        State(boolean active, int index, List<String> packages, Set<String> skipped) {
+        State(boolean active, int index, List<String> packages, Set<String> skipped, boolean autoAdvance) {
             this.active = active;
             this.index = index;
             this.packages = packages;
             this.skipped = skipped;
+            this.autoAdvance = autoAdvance;
         }
 
         boolean isComplete() {
@@ -58,20 +61,36 @@ final class GuidedReviewStore {
         int storedIndex = prefs.getInt(KEY_INDEX, 0);
         int index = Math.max(0, Math.min(storedIndex, packages.size()));
         boolean active = prefs.getBoolean(KEY_ACTIVE, false) && !packages.isEmpty() && index < packages.size();
-        return new State(active, index, packages, skipped);
+        boolean autoAdvance = prefs.getBoolean(KEY_AUTO_ADVANCE, false);
+        return new State(active, index, packages, skipped, autoAdvance);
     }
 
     boolean start(List<String> packages) {
+        return start(packages, false);
+    }
+
+    boolean start(List<String> packages, boolean autoAdvance) {
         List<String> safe = packages == null ? new ArrayList<>() : new ArrayList<>(packages);
         boolean committed = prefs.edit()
                 .putBoolean(KEY_ACTIVE, !safe.isEmpty())
                 .putInt(KEY_INDEX, 0)
                 .putString(KEY_PACKAGES, join(safe))
                 .putString(KEY_SKIPPED, "")
+                .putBoolean(KEY_AUTO_ADVANCE, autoAdvance)
                 .commit();
         if (!committed) return false;
         State state = load();
-        return state.packages.equals(safe) && state.index == 0 && state.active == !safe.isEmpty();
+        return state.packages.equals(safe)
+                && state.index == 0
+                && state.active == !safe.isEmpty()
+                && state.autoAdvance == autoAdvance;
+    }
+
+    boolean setAutoAdvance(boolean enabled) {
+        State before = load();
+        if (before.packages.isEmpty()) return false;
+        if (!prefs.edit().putBoolean(KEY_AUTO_ADVANCE, enabled).commit()) return false;
+        return load().autoAdvance == enabled;
     }
 
     boolean advance(boolean skippedCurrent) {
