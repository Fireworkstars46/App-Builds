          lines.push("- discovered JS assets: " + (scan.discoveredAssets == null ? "unknown" : scan.discoveredAssets));
          lines.push("- fetched/scanned assets: " + (scan.fetchedAssets == null ? "unknown" : scan.fetchedAssets));
