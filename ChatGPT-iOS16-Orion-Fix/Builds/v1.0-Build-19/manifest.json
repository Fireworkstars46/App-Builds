{
  "manifest_version": 3,
  "name": "ChatGPT iOS 16 URL.canParse Fix",
  "version": "1.0.18",
  "description": "Adds targeted iOS 16 compatibility shims plus a Build 19 CSP-compatible module bridge for ChatGPT. Removes the ChatGPT main-document CSP header with a narrow declarative rule, immediately installs a replacement script policy, then replays transformed RegExp-v modules. Optional diagnostics default OFF.",
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "action": {
    "default_title": "ChatGPT iOS 16 Fix",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://auth.openai.com/*",
        "https://auth0.openai.com/*",
        "https://setup.auth.openai.com/*",
        "https://frontend-apps-multi-region.workos.com/*",
        "https://forwarder.workos.com/*"
      ],
      "js": [
        "polyfill.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "module-compat.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "main-probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "light-diagnostic.js"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "chatgpt-csp-bridge",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
