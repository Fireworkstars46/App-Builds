     intercepted: false,
     replayed: false,
     modulePreloads: 0,
@@ -44,6 +49,40 @@
     window[STATUS_KEY] = status;
   }
 
+  function ensureReplacementCsp() {
+    try {
+      if (document.querySelector && document.querySelector("meta[" + CSP_ATTR + "='1']")) {
+        status.replacementCspInstalled = true;
+        return true;
+      }
+      const head = document.head;
+      if (!head || typeof document.createElement !== "function") return false;
+      const meta = document.createElement("meta");
+      meta.setAttribute("http-equiv", "Content-Security-Policy");
+      meta.setAttribute("content", REPLACEMENT_CSP);
+      meta.setAttribute(CSP_ATTR, "1");
+      head.insertBefore(meta, head.firstChild || null);
+      status.replacementCspInstalled = true;
+      return true;
+    } catch (_) {
+      return false;
+    }
+  }
+
+  function startCspObserver() {
+    if (ensureReplacementCsp()) return;
+    if (typeof MutationObserver !== "function") return;
+    cspObserver = new MutationObserver(() => {
+      if (!ensureReplacementCsp()) return;
+      try { cspObserver.disconnect(); } catch (_) {}
+      cspObserver = null;
+    });
+    try { cspObserver.observe(document, { childList: true, subtree: true }); }
+    catch (_) { cspObserver = null; }
+  }
+
+  startCspObserver();
+
   if (status.regexpVNative) {
