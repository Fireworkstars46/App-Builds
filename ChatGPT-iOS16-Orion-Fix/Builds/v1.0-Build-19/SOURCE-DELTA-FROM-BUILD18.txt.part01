+  const CSP_ATTR = "data-chatgpt-ios16-csp-bridge";
+  const REPLACEMENT_CSP = "default-src 'self' https: data: blob:; script-src 'self' blob: 'unsafe-inline' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'self'; connect-src 'self' https: wss:; img-src 'self' https: data: blob:; style-src 'self' https: 'unsafe-inline'; font-src 'self' https: data:; frame-src https:; worker-src 'self' blob:";
   let capturedEntry = null;
   let observer = null;
+  let cspObserver = null;
   let started = false;
 
   const status = {
-    build: 18,
+    build: 19,
     active: true,
     regexpVNative: supportsVFlag(),
     importMapSupported: supportsImportMaps(),
+    cspHeaderRuleExpected: true,
