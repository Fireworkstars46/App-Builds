+    Set.prototype.union = undefined;
+    Set.prototype.intersection = undefined;
+    ArrayBuffer.prototype.transfer = undefined;
+    Uint8Array.fromBase64 = undefined;
+    Uint8Array.prototype.toBase64 = undefined;
+  `, c);
+  vm.runInContext(read('polyfill.js'), c);
+  return c;
