+function compatibilityContext() {
+  class TestURL extends URL {}
+  class TestHTMLElement {}
+  const c = {
+    URL: TestURL,
+    Object,
+    Map,
+    Number,
+    TypeError,
+    RangeError,
+    SyntaxError,
+    Symbol,
+    console,
+    atob,
+    btoa,
+    structuredClone,
+    WeakSet,
+    HTMLElement: TestHTMLElement
