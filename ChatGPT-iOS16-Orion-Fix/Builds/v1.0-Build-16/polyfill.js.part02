    if (options === null || (typeof options !== "object" && typeof options !== "function")) {
      throw new TypeError("Base64 options must be an object");
    }
    const alphabet = options.alphabet === undefined ? "base64" : options.alphabet;
    if (alphabet !== "base64" && alphabet !== "base64url") {
      throw new TypeError("Invalid Base64 alphabet");
    }
    if (encode) {
      return { alphabet, omitPadding: Boolean(options.omitPadding) };
    }
    const lastChunkHandling = options.lastChunkHandling === undefined
      ? "loose"
      : options.lastChunkHandling;
    if (
      lastChunkHandling !== "loose" &&
      lastChunkHandling !== "strict" &&
      lastChunkHandling !== "stop-before-partial"
    ) {
      throw new TypeError("Invalid Base64 lastChunkHandling");
    }
    return { alphabet, lastChunkHandling };
  }

  function decodeBase64(input, options) {
    if (typeof input !== "string") throw new TypeError("Base64 input must be a string");
    const parsed = readBase64Options(options, false);
    let text = input.replace(/[\t\n\f\r ]/g, "");
    if (parsed.alphabet === "base64url") {
      if (/[^A-Za-z0-9_\-=]/.test(text)) throw new SyntaxError("Invalid Base64 input");
      text = text.replace(/-/g, "+").replace(/_/g, "/");
    } else if (/[^A-Za-z0-9+/=]/.test(text)) {
      throw new SyntaxError("Invalid Base64 input");
    }

    if (!/^[A-Za-z0-9+/]*={0,2}$/.test(text)) {
      throw new SyntaxError("Invalid Base64 input");
    }

    const firstPadding = text.indexOf("=");
    const unpadded = firstPadding >= 0 ? text.slice(0, firstPadding) : text;
    const remainder = unpadded.length % 4;
    if (remainder === 1) throw new SyntaxError("Invalid Base64 input");

    if (parsed.lastChunkHandling === "stop-before-partial" && firstPadding < 0 && remainder !== 0) {
      text = unpadded.slice(0, unpadded.length - remainder);
    } else if (parsed.lastChunkHandling === "strict") {
      if (remainder !== 0 && text.length % 4 !== 0) {
        throw new SyntaxError("Invalid Base64 input");
      }
    } else {
      while (text.length % 4 !== 0) text += "=";
    }

    let binary;
    try {
      binary = atob(text);
    } catch (_) {
