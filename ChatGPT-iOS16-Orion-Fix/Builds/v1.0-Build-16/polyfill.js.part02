  // The Popover API cannot be fully reproduced without browser top-layer support.
  // These shims intentionally provide only safe method presence/state tracking to
  // prevent direct calls from aborting startup on iOS 16.
  if (typeof HTMLElement !== "undefined" && HTMLElement.prototype) {
    const openPopovers = typeof WeakSet === "function" ? new WeakSet() : null;

    defineMethod(HTMLElement.prototype, "showPopover", function showPopover() {
      if (openPopovers) openPopovers.add(this);
      return undefined;
    });

    defineMethod(HTMLElement.prototype, "hidePopover", function hidePopover() {
      if (openPopovers) openPopovers.delete(this);
      return undefined;
    });

    defineMethod(HTMLElement.prototype, "togglePopover", function togglePopover(force) {
      const currentlyOpen = openPopovers ? openPopovers.has(this) : false;
      const shouldOpen = arguments.length > 0 && typeof force === "boolean"
