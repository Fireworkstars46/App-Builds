 if (typeof ArrayBuffer !== "undefined") {
    defineMethod(ArrayBuffer.prototype, "transfer", function transfer(newByteLength) {
      if (Object.prototype.toString.call(this) !== "[object ArrayBuffer]") {
        throw new TypeError("ArrayBuffer.transfer called on incompatible receiver");
      }
      return transferArrayBuffer(this, newByteLength);
