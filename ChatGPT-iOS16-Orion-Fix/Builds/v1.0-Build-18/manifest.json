{
  "manifest_version": 3,
  "name": "ChatGPT iOS 16 URL.canParse Fix",
  "version": "1.0.17",
  "description": "Adds targeted iOS 16 compatibility shims for ChatGPT plus a Build 18 module bridge that rewrites RegExp v literals in affected public ChatGPT modules before Safari 16 parses them. Optional diagnostics default OFF.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "ChatGPT iOS 16 Fix",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://auth.openai.com/*",
        "https://auth0.openai.com/*",
        "https://setup.auth.openai.com/*",
        "https://frontend-apps-multi-region.workos.com/*",
        "https://forwarder.workos.com/*"
      ],
      "js": [
        "polyfill.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "module-compat.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "main-probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "light-diagnostic.js"
      ],
      "run_at": "document_start"
    }
  ]
}
